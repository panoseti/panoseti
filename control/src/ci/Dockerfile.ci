# ═══════════════════════════════════════════════════════════════════════════
# Stage: base
# Python + panoseti-grpc dev dependencies. Inherited by all test stages.
# ═══════════════════════════════════════════════════════════════════════════
FROM python:3.14-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    iputils-ping \
    gcc build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Dependency Caching Layer
COPY grpc/ /grpc/
COPY control/pyproject.toml control/uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-install-project --all-extras

# ═══════════════════════════════════════════════════════════════════════════
# Stage: headnode
# Unified runner for lint, unit, structural, and integration tests.
# ═══════════════════════════════════════════════════════════════════════════
FROM base AS headnode

# ── UID/GID parity ───────────────────────────────────────────────────────────
# Build with the host user's UID/GID so container-written files (locks, transfer
# queue, calibration outputs, quabo_uids.json) are owned by the same user that
# runs pseti on the host.  Build via:
#   pseti test hw build   (auto-injects HOST_UID/HOST_GID from 'id')
# or manually:
#   docker build --build-arg HOST_UID=$(id -u) --build-arg HOST_GID=$(id -g) ...
ARG HOST_UID=1000
ARG HOST_GID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
    rsync openssh-client docker.io curl \
    vim tree procps htop \
    && rm -rf /var/lib/apt/lists/*

# Copy software version info from repo root
# COPY sw_info.json /sw_info.json

# Copy source code (this layer invalidates if control/ changes)
COPY control/ .
RUN mkdir -p /data /data/head

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-extras

# Install shell completion for pseti
RUN mkdir -p /etc/bash_completion.d && \
    /bin/bash -c "pseti --show-completion bash > /etc/bash_completion.d/pseti"

# Create the panoseti user with matching host UID/GID for seamless volume mounting.
# We use the -o (non-unique) flag to force creation even if the ID is already 
# used by a default system account in the base image (e.g., ubuntu or node).
RUN groupadd -o -g "${HOST_GID}" panoseti \
 && useradd -o -u "${HOST_UID}" -g "${HOST_GID}" -m -s /bin/bash panoseti \
 && chown -R panoseti:panoseti /app /data /opt/venv /etc/bash_completion.d/pseti

USER panoseti

CMD ["sleep", "infinity"]

# ═══════════════════════════════════════════════════════════════════════════
# Stage: test-runner (alias of headnode)
# ═══════════════════════════════════════════════════════════════════════════
FROM headnode AS test-runner

# ═══════════════════════════════════════════════════════════════════════════
# Stage: hashpipe-builder (needed for integration)
# ═══════════════════════════════════════════════════════════════════════════
FROM python:3.14-slim AS hashpipe-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git autoconf automake libtool g++ make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN git clone --depth 1 https://github.com/david-macmahon/hashpipe.git hashpipe
WORKDIR /build/hashpipe/src
RUN autoreconf -is && ./configure --prefix=/usr/local && make && make install

# ═══════════════════════════════════════════════════════════════════════════
# Stage: hashpipe-plugin-builder (needed for integration)
# ═══════════════════════════════════════════════════════════════════════════
FROM hashpipe-builder AS hashpipe-plugin-builder
ENV PANOSETI_DAQ_BRANCH="dev"
WORKDIR /build
RUN git clone --depth 1 --branch ${PANOSETI_DAQ_BRANCH} https://github.com/panoseti/panoseti_daq.git panoseti_daq
WORKDIR /build/panoseti_daq
COPY control/src/ci/fixtures/build/Makefile .
COPY control/src/ci/fixtures/build/databuf.h .
RUN make

# ═══════════════════════════════════════════════════════════════════════════
# Stage: integration-daqnode
# ═══════════════════════════════════════════════════════════════════════════
FROM base AS integration-daqnode
RUN apt-get update && apt-get install -y --no-install-recommends \
    socat tcpreplay procps \
    && rm -rf /var/lib/apt/lists/*

# Copy core hashpipe binaries and libraries from builder surgically
COPY --from=hashpipe-builder /usr/local/bin/hashpipe /usr/local/bin/hashpipe
COPY --from=hashpipe-builder /usr/local/lib/libhashpipe* /usr/local/lib/
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/usr-local-lib.conf && ldconfig

RUN mkdir -p /data
COPY --from=hashpipe-plugin-builder /build/panoseti_daq/hashpipe.so /data/hashpipe.so
COPY --from=hashpipe-plugin-builder /build/panoseti_daq/hashpipe.so /usr/local/lib/panoseti_hashpipe.so
WORKDIR /app
# Copy software version info from repo root
# COPY sw_info.json /sw_info.json
COPY control/ .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-extras

# Install shell completion for pseti
RUN mkdir -p /etc/bash_completion.d && \
    /bin/bash -c "pseti --show-completion bash > /etc/bash_completion.d/pseti"

CMD ["/bin/sh", "-c", "mkdir -p ${DAQ_DATA_DIR:-/data} && cp /usr/local/lib/panoseti_hashpipe.so ${DAQ_DATA_DIR:-/data}/hashpipe.so && exec pseti-grpc server --config ${GRPC_SERVER_CONFIG:-/app/src/ci/fixtures/configs/grpc/daqnode/server.toml}"]

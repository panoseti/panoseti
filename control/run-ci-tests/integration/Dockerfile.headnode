# Dockerfile.headnode — Head node / test runner image for integration tests.
#
# Build context: panoseti-software/control/
# (Set by docker-compose.integration.yml context: ../)
#
# Contains:
#   - panoseti-software control/ package (with all dev deps)
#   - panoseti_grpc (for DaqControlClient, DaqDataClient, etc.)
#   - rsync, ssh-client for data collection simulation

FROM python:3.14-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc build-essential \
        rsync \
        openssh-client \
        docker.io \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install panoseti_grpc from pre-built wheel (placed by run-integration-tests.sh)
COPY run-ci-tests/integration/wheels/ /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/panoseti*.whl 2>/dev/null \
    || pip install --no-cache-dir "panoseti-grpc>=0.4.0"

# Install panoseti control package with dev extras
COPY pyproject.toml .
RUN pip install --no-cache-dir \
        netifaces-plus \
    && pip install --no-cache-dir -e ".[dev]" \
    || pip install --no-cache-dir \
        pytest>=8.0 \
        pytest-asyncio>=0.23 \
        pytest-mock>=3.12 \
        fakeredis>=2.26 \
        pydantic>=2.0 \
        haversine>=2.9 \
        rich>=13.0 \
        numpy>=1.24 \
        redis>=7 \
        psutil>=5.9 \
        requests>=2.31 \
        docker>=7.0

# Copy full control/ source
COPY . .

# Create data directories
RUN mkdir -p /data /data/head

CMD ["pytest", "tests/integration/", "-v", "--tb=short", "--color=yes"]

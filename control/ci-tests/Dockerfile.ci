# ═══════════════════════════════════════════════════════════════════════════
# Stage: base
# Python + panoseti-grpc dev dependencies. Inherited by all test stages.
# ═══════════════════════════════════════════════════════════════════════════
FROM python:3.14-slim AS base

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

# Install panoseti-grpc and test dependencies
# BuildKit cache mount keeps pip wheel cache between builds → fast re-installs
# when pyproject.toml is unchanged.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e ".[dev]"

# Extra deps needed by integration tests but not in pyproject.toml dev extras
# pytest-xdist: parallel unit-test execution (-n auto)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    "redis>=7" "requests>=2.31" "docker>=7.0" "pytest-timeout>=2.0" "pytest-xdist>=3.0"


# ═══════════════════════════════════════════════════════════════════════════
# Stage: hashpipe-builder
# Compiles hashpipe from source.  Both daq-data-hashpipe and daq-control
# COPY from this stage, so hashpipe is built exactly once.
# ═══════════════════════════════════════════════════════════════════════════
FROM python:3.14-slim AS hashpipe-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git autoconf automake libtool g++ make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 https://github.com/david-macmahon/hashpipe.git hashpipe
WORKDIR /build/hashpipe/src
RUN autoreconf -is && \
    ./configure --prefix=/usr/local && \
    make && \
    make install

# ═══════════════════════════════════════════════════════════════════════════
# Stage: daq-data-hashpipe-plugin-builder
# Clones panoseti_daq and compiles it with the daq_data_hashpipe Makefile.
# Separate from daq-control-plugin-builder because the two Makefiles differ
# (daq_control adds process_frame.c).
# ═══════════════════════════════════════════════════════════════════════════
FROM hashpipe-builder AS hashpipe-plugin-builder

ENV PANOSETI_DAQ_BRANCH="dev"

WORKDIR /build
RUN git clone --depth 1 --branch ${PANOSETI_DAQ_BRANCH} https://github.com/panoseti/panoseti_daq.git panoseti_daq
WORKDIR /build/panoseti_daq
COPY ci-tests/integration/build/Makefile .
COPY ci-tests/integration/build/databuf.h .
RUN make

# ═══════════════════════════════════════════════════════════════════════════
# Stage: unit-test-runner
# Runs standard hardware-agnostic Python unit tests.
# ═══════════════════════════════════════════════════════════════════════════
FROM base AS unit-test-runner
COPY . .
CMD ["pytest", "ci-tests/unit/", "-v", "--tb=short", "--color=yes"]


# ═══════════════════════════════════════════════════════════════════════════
# Stage: integration-headnode (Test Runner)
# Acts as the headnode running the pytest integration suite.
# ═══════════════════════════════════════════════════════════════════════════
FROM base AS integration-headnode
RUN apt-get update && apt-get install -y --no-install-recommends \
    rsync openssh-client docker.io \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN mkdir -p /data /data/head

CMD ["pytest", "ci-tests/integration/", "-v", "--tb=short", "--color=yes"]

# ═══════════════════════════════════════════════════════════════════════════
# Stage: integration-daqnode
# The DAQ node simulation. Runs the unified panoseti-server (daq_data +
# daq_control on port 50051), real hashpipe binary, tcpreplay for pcap
# simulation, and socat for gateway tests.
# ═══════════════════════════════════════════════════════════════════════════
FROM base AS integration-daqnode
RUN apt-get update && apt-get install -y --no-install-recommends \
    socat tcpreplay \
    && rm -rf /var/lib/apt/lists/*

# Copy core hashpipe binaries and libraries from builder
COPY --from=hashpipe-builder /usr/local/bin/hashpipe /usr/local/bin/hashpipe
COPY --from=hashpipe-builder /usr/local/lib/libhashpipe* /usr/local/lib/
RUN ldconfig

# Copy the panoseti_daq plugin to /data/ (fallback) AND to /usr/local/lib/ (persistent).
# The entrypoint always copies from /usr/local/lib/ into /data/ at startup so
# the plugin survives Docker volume initialization races on the shared daq_data volume.
RUN mkdir -p /data
COPY --from=hashpipe-plugin-builder /build/panoseti_daq/hashpipe.so /data/hashpipe.so
COPY --from=hashpipe-plugin-builder /build/panoseti_daq/hashpipe.so /usr/local/lib/panoseti_hashpipe.so

WORKDIR /app
COPY . .

# Unified gRPC server: daq_data + daq_control on a single port (50051).
# hashpipe UDS sockets live in /tmp inside this container — no shared volume needed.
CMD ["/bin/sh", "-c", "cp /usr/local/lib/panoseti_hashpipe.so /data/hashpipe.so && exec panoseti-server --config /app/ci-tests/integration/configs/daqnode/server.toml"]

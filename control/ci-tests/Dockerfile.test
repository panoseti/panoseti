# Dockerfile.test — PANOSETI control/ test runner image
# Build context: control/  (one level above this file)
FROM python:3.14-slim

WORKDIR /app

# System dependencies for packages that need compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python package with dev extras
# pyproject.toml is at /app/pyproject.toml (context = control/)
COPY pyproject.toml .

RUN pip install --no-cache-dir -e ".[dev]" \
    || pip install --no-cache-dir \
        pytest>=8.0 \
        pytest-asyncio>=0.23 \
        pytest-mock>=3.12 \
        fakeredis>=2.26 \
        pydantic>=2.0 \
        haversine>=2.9 \
        rich>=13.0 \
        numpy>=1.24 \
        redis>=7 \
        psutil>=5.9

# Copy the full control/ directory
COPY . .

# Default: run unit tests
CMD ["pytest", "tests/unit/", "-v", "--tb=short", "--color=yes"]

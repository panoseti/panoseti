# PanoSETI Environment Configuration (.env.example)
#
# Copy this file to `.env` in your working directory (or wherever you run pseti from)
# to customize the control software behavior without modifying your shell profile.
#
# The `pseti` CLI automatically loads `.env` from the current working directory at startup.
# To point to a specific file instead:
#   PSETI_ENV_FILE=/path/to/my-site.env pseti start
#
# To disable .env loading entirely:
#   pseti --no-env start
#
# NOTE: Variables loaded here take effect inside the pseti process only.
# They will NOT appear in `printenv` or be visible to the shell — that is expected.
# Use `pseti paths` to verify which path overrides are active inside the process.
#
# All values must be uncommented (remove the leading `#`) to take effect.

# ==============================================================================
# Common Configuration
# ==============================================================================

# Path to the active configuration directory (contains obs_config.json, daq_config.json, etc.)
# Default: control/configs  (relative to the repository root)
# PSETI_CONFIG=/path/to/panoseti-software/control/configs/lick

# ==============================================================================
# Data and State Directories
# ==============================================================================

# Directory where observatory state, telemetry, and runs are tracked
# Default: ~/.panoseti
# PSETI_STATE=~/.panoseti

# Directory where active recording run data is stored
# Default: PSETI_STATE/runs
# PSETI_RUNS_DIR=/mnt/data/runs

# Directory where logs are written
# Default: PSETI_STATE/logs
# PSETI_LOGS=/mnt/data/logs

# Directory for temporary files and caches
# Default: /tmp/panoseti
# PSETI_TMP=/tmp/panoseti

# Directory for calibration data
# Default: PSETI_STATE/calib
# PSETI_CALIB_DIR=/mnt/data/calib

# ==============================================================================
# gRPC / Headnode Networking
# ==============================================================================
#
# HEADNODE_GRPC_PORT and DAQNODE_GRPC_PORT are the two canonical vars for
# gRPC bind/connect ports -- they are read by BOTH sides:
#   - the unified gRPC server (grpc's unified_main.py --port-env seam,
#     wired in by every docker-compose file / systemd unit in this repo)
#   - every control-plane and daq_data client (control.utils.util's
#     resolve_grpc_port(), used by daq_grpc_endpoint(), pseti health,
#     pseti stat, pseti show sci, ...)
# Setting one of these here is now sufficient on its own to move BOTH the
# server and every client -- no TOML file needs hand-editing. See
# wiki_docs's "Co-locating Head Node and DAQ Node" section.

# Port for the headnode's unified gRPC server (telemetry + daq_data gateway)
# and every client connecting to it.
# Default: 50051
# HEADNODE_GRPC_PORT=50051

# Port for each DAQ node's unified gRPC server (daq_data edge + daq_control)
# and every control-plane client connecting to a DAQ node directly (not
# through a network_config.json port-forwarding gateway -- a forwarded
# node's port_forwarding.grpc_port, if set, always takes precedence over
# this fleet-wide default; see Configuration-files for that per-node field).
# REQUIRED to differ from HEADNODE_GRPC_PORT when headnode and a DAQ node
# are co-located on the same machine (both run with network_mode: host, so
# they'd otherwise fight over one port -- pseti health's port/dir collision
# check catches this before it becomes a "container keeps restarting" bug).
# Default: 50051
# DAQNODE_GRPC_PORT=50052

# Host where the headnode DAQ data gateway is running (used by `pseti stat -w` / `pseti show sci`)
# Default: localhost
# DAQ_DATA_GATEWAY_HOST=localhost

# DEPRECATED: alias for HEADNODE_GRPC_PORT, read as a low-priority fallback
# for one release. Prefer HEADNODE_GRPC_PORT above -- it's also read by the
# server side, which this var never was.
# DAQ_DATA_GATEWAY_PORT=50052

# Legacy, lowest-priority fallback read by both HEADNODE_GRPC_PORT and
# DAQNODE_GRPC_PORT's resolvers when neither role-specific var is set.
# Prefer the role-specific vars above -- this can't express the co-located
# case (head and daq need *different* values).
# Default: 50051
# GRPC_PORT=50051

# This machine's real, externally-reachable IP -- required by
# `pseti admin deploy` (Alloy needs it to push logs to Loki) and used as the
# default DAQ_DATA_GATEWAY_HOST target by grpc's CLI/telemetry clients.
# HEADNODE_IP=192.168.88.103

# Host-side data directories used by `pseti admin deploy`'s docker-compose
# invocations. On a co-located head+DAQ node these MUST be distinct (see
# pseti health's collision check) -- DAQ_DATA_DIR is the DAQ node's raw
# .pff output, PSETI_DATA_DIR is the headnode services' durable state
# (Redis/InfluxDB/Loki/Grafana). Not the same thing as PSETI_STATE below,
# which is the *control process's* own state directory.
# DAQ_DATA_DIR=/mnt/panoseti-data/daq
# PSETI_DATA_DIR=/mnt/panoseti-data

# ==============================================================================
# Supporting Service Overrides (Redis, Loki)
# ==============================================================================

# Redis host used by the telemetry capture service
# Default: localhost
# REDIS_HOST=localhost

# Loki URL for log shipping
# Default: http://localhost:3100
# LOKI_URL=http://localhost:3100

# ==============================================================================
# Control Software Paths (Advanced)
# ==============================================================================
# Overriding PSETI_ROOT or PSETI_CONTROL shifts the default location of all
# sub-directories below them. Only set these if you have a non-standard layout.

# Root directory of the panoseti-software repository
# Default: Auto-detected based on the executable path
# PSETI_ROOT=/path/to/panoseti-software

# Path to the control software module
# Default: PSETI_ROOT/control
# PSETI_CONTROL=/path/to/panoseti-software/control

# Directory containing firmware binaries
# Default: PSETI_CONTROL/firmware
# PSETI_FIRMWARE=/path/to/panoseti-software/control/firmware

# Directory for DAQ scripts (e.g. hashpipe scripts)
# Default: PSETI_ROOT/daq/scripts
# PSETI_DAQ_SCRIPTS=/path/to/panoseti-software/daq/scripts

# Directory containing White Rabbit configuration and scripts
# Default: PSETI_CONTROL/wr
# PSETI_WR=/path/to/panoseti-software/control/wr

# Directory containing Quabo operational files
# Default: PSETI_CONTROL/quabos
# PSETI_QUABOS=/path/to/panoseti-software/control/quabos
